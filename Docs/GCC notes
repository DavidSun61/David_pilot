write a simple C code to print the Unix time. 

#include <stdio.h>
#include <time.h>

int main(void) {
    // Get the current time as a time_t object
    time_t current_time = time(NULL);

    // Print the timestamp (cast to long long for safety across platforms)
    printf("Unix Timestamp: %lld\n", (long long)current_time);

    return 0;
}

But it on print one time and could not cause the loop. so edit the code to print the time every second while forming a loop on purpose.

#include <stdio.h>
#include <time.h>
#include <unistd.h>

int main(void) {
    // Disable stdout buffering to ensure the timestamp prints immediately
    setbuf(stdout, NULL);

    while (1) {
        // Get the current UNIX timestamp (seconds since Jan 1, 1970)
        time_t current_time = time(NULL);

    // Print the timestamp (cast to long long for safety across platforms)
    printf("Unix Timestamp: %lld\n", (long long)current_time);

        // Pause execution for 1 second
        sleep(1);
    }

    return 0;
}

